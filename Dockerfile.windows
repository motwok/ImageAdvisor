# SPDX-License-Identifier: AGPL-3.0-or-later
# Windows variant. dist/imageadvisor.exe is built before (see docs/Build.md);
# no RUN, so buildx on Linux can build it too.
ARG OSVERSION=ltsc2022
FROM mcr.microsoft.com/windows/nanoserver:${OSVERSION}
COPY dist/imageadvisor.exe /imageadvisor.exe
# The Docker engine pipe is open to administrators only.
USER ContainerAdministrator
LABEL org.opencontainers.image.source="https://github.com/motwok/ImageAdvisor" \
      org.opencontainers.image.description="Prometheus exporter that reports which containers have a newer image in their registry." \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
EXPOSE 8080
ENTRYPOINT ["C:\\imageadvisor.exe"]
CMD ["--config.file=C:\\data\\config.yml", "--storage.path=C:\\data"]
